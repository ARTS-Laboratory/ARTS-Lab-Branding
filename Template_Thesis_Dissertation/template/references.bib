@Article{Zeng2021reviewthermalphysics,
  author   = {Yuqiang Zeng and Divya Chalise and Sean D. Lubner and Sumanjeet Kaur and Ravi S. Prasher},
  journal  = {Energy Storage Materials},
  title    = {A review of thermal physics and management inside lithium-ion batteries for high energy density and fast charging},
  year     = {2021},
  issn     = {2405-8297},
  pages    = {264-288},
  volume   = {41},
  abstract = {Traditionally it has been assumed that battery thermal management systems should be designed to maintain the battery temperature around room temperature. That is not always true as lithium-ion battery (LIB) R&D is pivoting towards the development of high energy density and fast charging batteries. Therefore, it is necessary to have a comprehensive review of thermal considerations for LIBs targeted for high energy density and fast charging, i.e., the optimal thermal condition, thermal physics (heat transport and generation) inside the battery, and thermal management strategies. As the energy density and charge rate increases, the optimal battery temperature can shift to be higher than room temperature. In the first part of the review various sources of heat generation inside LIBs and various approaches to minimizing battery heat generation are summarized. The importance of heat of mixing due to ion diffusion during fast charging is also highlighted. To improve the temperature uniformity and avoid excessive internal temperature rise, heat transfer inside the battery needs to be enhanced, and reducing the thermal contact resistance between the electrodes and separator can significantly increase the effective thermal conductivity of batteries. In the second part of the review various challenges and latest developments related to thermal transport and properties of LIBs are discussed. Finally, a summary of latest advancement on smart control of internal temperature of LIBs is discussed as depending on the ambient temperature and the optimal temperature; the battery heat needs to be retained or dissipated to elevate or avoid temperature rise.},
  doi      = {https://doi.org/10.1016/j.ensm.2021.06.008},
  keywords = {Lithium-ion battery, Optimal battery temperature, High energy density, Fast charging, Battery thermal management},
  url      = {https://www.sciencedirect.com/science/article/pii/S2405829721002695},
}

@Article{Verma2022PerformanceanalysisPCM,
  author   = {Ashima Verma and Dibakar Rakshit},
  journal  = {Thermal Science and Engineering Progress},
  title    = {Performance analysis of PCM-fin combination for heat abatement of Li-ion battery pack in electric vehicles at high ambient temperature},
  year     = {2022},
  issn     = {2451-9049},
  pages    = {101314},
  volume   = {32},
  abstract = {Lithium-ion (Li-ion) battery’s performance in an electric vehicle is highly susceptible to the driving cycle and ambient conditions. Overloading of the Li-ion battery during adverse driving conditions can cause thermal runaway. The results can be hazardous if the implications are ignored. Thus, thermal management of the Li-ion battery pack is crucial. This study presents the results of a parametric investigation of the thermal behaviour of Li-ion battery pack in high ambient temperature for different power conditions. A novel passive cooling arrangement of fins and phase change material (PCM) is proposed as a passive solution. The PCM layers are crammed in between batteries, and PCM layers of three different thicknesses, 7 mm, 9 mm, and 12 mm, are considered for the parametric study. Additional improvement in the design is made by inserting eight aluminium longitudinal fins along the vertical cross-section of the cells. The analysis revealed that the maximum temperature of the proposed battery pack dropped by 16 K, 22 K, and 26 K for the PCM thicknesses of 7 mm, 9 mm, and 12 mm, respectively, when 30 mm long longitudinal fins are employed. It was also observed that the minimum liquid fraction improved by 91.7 % by increasing the PCM thickness and fin length, which can give an extra time window for peak heat absorption to the PCM material. The longitudinal fins employed as an additional heat sink improved the temperature distribution among the cells and capped disparities in temperature distribution close to 5 K.},
  doi      = {https://doi.org/10.1016/j.tsep.2022.101314},
  keywords = {Lithium-ion battery, Battery thermal management system, Passive cooling, Phase change material, Fins},
  url      = {https://www.sciencedirect.com/science/article/pii/S2451904922001214},
}

